# Testanfragen (Visual Studio, VS Code REST Client, JetBrains)
# Lokal direkt am Dienst (ohne Präfix):
@base = http://localhost:5091
# Im Cluster über nginx:  @base = http://shop.k8s-lab/api/catalog

